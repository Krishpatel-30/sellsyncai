# ==============================================================================
# SellSync AI - Multi-Marketplace E-commerce SaaS Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="SellSync AI"
APP_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars-long
ENCRYPTION_KEY=change-this-32-char-key-for-aes-256-gcm-01234567

# Security & JWT Tokens
JWT_SECRET=super-secret-jwt-signing-key-for-sellsync-ai-2026
JWT_REFRESH_SECRET=super-secret-jwt-refresh-signing-key-for-sellsync-ai-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL Production / SQLite async for local test)
# For local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/sellsync_db
# For SQLite test: sqlite+aiosqlite:///./sellsync.db
DATABASE_URL=sqlite+aiosqlite:///./sellsync.db
DATABASE_SYNC_URL=sqlite:///./sellsync.db
DB_ECHO=False

# Redis & Celery Worker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Providers (Provider-independent adapter)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Storage (AWS S3 or S3-compatible: MinIO / Cloudflare R2)
AWS_ACCESS_KEY_ID=placeholder-aws-access-key-id
AWS_SECRET_ACCESS_KEY=placeholder-aws-secret-access-key
AWS_S3_BUCKET=sellsync-product-media
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com

# Payment Gateways (India: Razorpay primary; International: Stripe)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Marketplace API Credentials (Configured once official developer access granted)
# Flipkart Seller API
FLIPKART_CLIENT_ID=flipkart_client_id_placeholder
FLIPKART_CLIENT_SECRET=flipkart_client_secret_placeholder
FLIPKART_ENV=sandbox

# Shopify Admin API
SHOPIFY_API_KEY=shopify_api_key_placeholder
SHOPIFY_API_SECRET=shopify_api_secret_placeholder
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory

# WooCommerce REST API
WOOCOMMERCE_CLIENT_ID=woocommerce_consumer_key_placeholder
WOOCOMMERCE_CLIENT_SECRET=woocommerce_consumer_secret_placeholder

# Initial Super Admin (Auto-seeded if enabled)
FIRST_SUPERADMIN_EMAIL=admin@sellsync.ai
FIRST_SUPERADMIN_PASSWORD=AdminSecurePassword123!
FIRST_SUPERADMIN_NAME="SellSync Platform Admin"

